FROM golang:1.27-alpine AS builder

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Migrations and tzdata are embedded in the binary, so the runtime image only needs the executable.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/gestorApp .

FROM alpine:3.24

RUN apk add --no-cache ca-certificates \
	&& adduser -D -H -u 10001 app

COPY --from=builder /out/gestorApp /usr/local/bin/gestorApp

USER app

CMD ["gestorApp"]
