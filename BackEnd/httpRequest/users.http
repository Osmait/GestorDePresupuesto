# Paste the access token from POST /auth/login here; never commit a real one.
@token = <access-token>

POST https://gestor-api.onrender.com/user
content-type: application/json

{
    "name":"Demo",
    "last_name":"Demo",
    "email":"demo@demo.com",
    "password":"12345678"
}

GET http://localhost:8080/profile
content-type: application/json
Authorization: Bearer {{token}}
