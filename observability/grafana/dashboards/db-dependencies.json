          "expr": "sum by (db_operation_name) (rate(db_client_operation_duration_seconds_count{job=\"$job\",db_operation_name=~\"sql.conn.begin_tx|sql.tx.commit|sql.tx.rollback\"}[$__rate_interval]))",
          "legendFormat": "{{db_operation_name}}",
          "refId": "A",
          "range": true,
          "instant": false
