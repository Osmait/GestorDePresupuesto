        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (db_query_summary) (rate(db_client_operation_duration_seconds_count{job=\"$job\",db_operation_name=~\"sql.conn.query|sql.conn.exec|sql.stmt.query|sql.stmt.exec\"}[$__rate_interval]))",
          "legendFormat": "{{db_query_summary}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
