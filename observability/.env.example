# Copy to observability/.env to change host ports or the backend scrape target.
OBS_OTLP_GRPC_PORT=4317
OBS_OTLP_HTTP_PORT=4318
OBS_JAEGER_UI_PORT=16686
OBS_PROMETHEUS_PORT=9090
OBS_GRAFANA_PORT=3001
# Where Prometheus scrapes the Go backend's /metrics (from inside Docker).
BACKEND_METRICS_TARGET=host.docker.internal:9464
# Must equal the backend's METRICS_TOKEN.
METRICS_TOKEN=local-dev-metrics-token-change-me
